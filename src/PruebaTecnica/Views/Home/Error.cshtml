@{
    ViewData["Title"] = "Error";
}

<div class="text-center py-5">
    <h1 class="h3">Ocurrió un error inesperado</h1>
    <p class="text-muted">No pudimos completar la operación. Intenta de nuevo en unos momentos.</p>
    <p class="small text-muted">Código de solicitud: @ViewData["RequestId"]</p>
    <a asp-controller="Home" asp-action="Index" class="btn btn-bac">Volver al inicio</a>
</div>
