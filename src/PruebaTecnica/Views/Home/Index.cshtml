@model IReadOnlyList<Categoria>
@{
    ViewData["Title"] = "Inicio";
}

@functions {
    static string Icono(string nombre) => nombre switch
    {
        "Carros" => "",
        "Animales" => "",
        _ => ""
    };
}

<div id="alerta" class="alert alert-danger d-none" role="alert"></div>

@* ------------------------- 1. Elegir categoría ------------------------- *@
<section id="panel-categorias">
    <h1 class="h3 text-center mb-1">¡Elige la temática!</h1>
    <p class="text-center text-muted mb-4">Cada partida tiene 3 preguntas de opcion multiple.</p>

    @if (Model.Count == 0)
    {
        <div class="alert alert-warning text-center">Todavía no hay categorías. Ejecuta el script de base de datos.</div>
    }
    else
    {
        <div class="row justify-content-center g-4">
            @foreach (var categoria in Model)
            {
                <div class="col-12 col-sm-6 col-lg-4">
                    <button type="button"
                            class="btn-categoria card h-100 w-100 text-center shadow-sm"
                            data-categoria-id="@categoria.Id"
                            data-categoria-nombre="@categoria.Nombre">
                        <span class="card-body py-5">
                            <span class="categoria-icono d-block mb-2">@Icono(categoria.Nombre)</span>
                            <span class="h4 d-block mb-1">@categoria.Nombre</span>
                            <span class="text-muted small d-block">@categoria.Descripcion</span>
                        </span>
                    </button>
                </div>
            }
        </div>
    }
</section>

@* ------------------------------ 2. Partida ------------------------------ *@
<section id="panel-juego" class="d-none">
    <div class="row justify-content-center">
        <div class="col-12 col-lg-8">
            <div class="card shadow-sm">
                <div class="card-body p-4">
                    <div class="d-flex justify-content-between align-items-center mb-2 small text-muted">
                        <span>Categoría: <strong id="juego-categoria"></strong></span>
                        <span id="juego-progreso"></span>
                    </div>
                    <div class="progress mb-4" role="progressbar" aria-label="Progreso de la partida" style="height: 8px;">
                        <div id="juego-barra" class="progress-bar" style="width: 0%"></div>
                    </div>

                    <h2 id="juego-pregunta" class="h4 mb-4"></h2>

                    <div id="juego-respuestas" class="list-group mb-3"></div>

                    <div id="juego-feedback" class="alert d-none py-2" role="status"></div>

                    <div class="text-end">
                        <button type="button" id="btn-siguiente" class="btn btn-bac d-none">Siguiente</button>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@* ------------------------------ 3. Resultado ------------------------------ *@
<section id="panel-resultado" class="d-none">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-6">
            <div class="card shadow-sm text-center">
                <div class="card-body p-5">
                    <div id="resultado-emoji" class="display-3 mb-2"></div>
                    <h2 id="resultado-titulo" class="h3"></h2>
                    <p class="lead mb-4">Acertaste <strong id="resultado-puntaje"></strong> de <strong id="resultado-total"></strong> preguntas.</p>

                    <div class="d-grid gap-2 d-sm-flex justify-content-sm-center">
                        <button type="button" id="btn-repetir" class="btn btn-bac">Jugar de nuevo</button>
                        <button type="button" id="btn-otra" class="btn btn-outline-secondary">Cambiar de categoría</button>
                        <a asp-action="Tablero" class="btn btn-outline-secondary">Ver tablero</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

@section Scripts {
    <script src="~/js/trivia.js" asp-append-version="true"></script>
}
