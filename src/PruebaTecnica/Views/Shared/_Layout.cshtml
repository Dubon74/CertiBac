@{
    var tab = ViewData["Tab"] as string;
    var autenticado = User.Identity?.IsAuthenticated == true;
}
<!DOCTYPE html>
<html lang="es">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>@(ViewData["Title"] ?? "Trivia") · CertiBAC</title>
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" />
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true" />
</head>
<body>
    <header class="app-header">
        <div class="container d-flex flex-wrap justify-content-between align-items-center py-3 gap-2">
            <a class="app-brand" asp-controller="Home" asp-action="Index">Certi<span>BAC</span></a>
            @if (autenticado)
            {
                <div class="d-flex align-items-center gap-3">
                    <span class="text-white-50">Hola, <strong class="text-white">@(User.Identity?.Name)</strong></span>
                    <form asp-controller="Account" asp-action="Logout" method="post" class="m-0">
                        <button type="submit" class="btn btn-outline-light btn-sm">Cerrar sesión</button>
                    </form>
                </div>
            }
        </div>
    </header>

    <main class="container py-4">
        @if (autenticado)
        {
            <ul class="nav nav-tabs app-tabs mb-4">
                <li class="nav-item">
                    <a class="nav-link @(tab == "inicio" ? "active" : "")" asp-controller="Home" asp-action="Index">Inicio</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link @(tab == "tablero" ? "active" : "")" asp-controller="Home" asp-action="Tablero">Tablero de posiciones</a>
                </li>
            </ul>
        }

        @RenderBody()
    </main>

    <footer class="text-center text-muted small py-4">Prueba técnica</footer>

    @if (autenticado)
    {
        @* Token anti-CSRF que lee trivia.js para las llamadas AJAX *@
        <form id="antiforgery-form" class="d-none">@Html.AntiForgeryToken()</form>
    }

    <script src="https://code.jquery.com/jquery-3.6.4.min.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
